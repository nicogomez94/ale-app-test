DATABASE_URL="postgresql://user:password@host:5432/base_compartida?schema=pas_alert_nico"
JWT_SECRET="your-super-secret-jwt-key-change-this"
# El backend toma primero MP_ACCESS_TOKEN_PROD y luego MP_ACCESS_TOKEN.
MP_ACCESS_TOKEN="TEST-YOUR-MERCADOPAGO-ACCESS-TOKEN"
MP_ACCESS_TOKEN_PROD="APP_USR-YOUR-PRODUCTION-ACCESS-TOKEN"
MP_PUBLIC_KEY_PROD="APP_USR-YOUR-PRODUCTION-PUBLIC-KEY"
MP_CLIENT_ID_PROD="YOUR-MP-CLIENT-ID"
MP_CLIENT_SECRET_PROD="YOUR-MP-CLIENT-SECRET"
MP_WEBHOOK_SECRET="YOUR-MERCADOPAGO-WEBHOOK-SECRET"
# Opcional: si querÃ©s forzar una URL de webhook distinta a la detectada automaticamente.
MP_WEBHOOK_URL="https://TU_API_PUBLICA/api/subscriptions/webhook"
APP_URL="http://localhost:5173"
SYSTEM_APP_URL="https://app.tudominio.com"
CORS_ALLOWED_ORIGINS="https://app.tudominio.com"
PORT=3001
# Required to encrypt/decrypt insurance portal passwords (use a long random value in production).
PORTAL_CREDENTIAL_SECRET="change-this-long-random-secret"
# Etapa B — cuponeras privadas y Meta WhatsApp Cloud API
COUPON_STORAGE_DIR="/var/lib/pas-alert/cuponeras"
COUPON_MAX_BYTES="10485760"
WHATSAPP_GRAPH_API_VERSION="vXX.X"
WHATSAPP_ACCESS_TOKEN="YOUR-SYSTEM-USER-ACCESS-TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR-PHONE-NUMBER-ID"
WHATSAPP_TEMPLATE_NAME="aviso_vencimiento_cuponera"
WHATSAPP_TEMPLATE_LANGUAGE="es_AR"
WHATSAPP_WEEKLY_TEMPLATE_NAME="resumen_semanal_vencimientos"
WHATSAPP_WEEKLY_TEMPLATE_LANGUAGE="es_AR"
WHATSAPP_WEEKLY_CHUNK_MAX_CHARS="900"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-this-webhook-verify-token"
WHATSAPP_APP_SECRET="YOUR-META-APP-SECRET"
WHATSAPP_DEFAULT_COUNTRY="AR"
# Email microservice (contact-form-service)
MAIL_SITE="PAS Alert"
MAIL_TO="nicolasgomez94@gmail.com"
COTIZACIONES_MAIL_TO="alejandro.rh.diaz@gmail.com"
# Google OAuth — obtener en console.cloud.google.com > Credenciales > OAuth 2.0
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
