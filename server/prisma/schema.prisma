generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum PlanType {
  TRIAL
  EMPRENDEDOR
  PROFESIONAL
  AGENCIA
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum UserStatus {
  ACTIVO
  INACTIVO
}

enum PolicyStatus {
  ACTIVA
  VENCE_PRONTO
  VENCIDA
}

enum PolicyType {
  INDIVIDUAL
  EMPRESA
}

enum PolicyVigencia {
  MENSUAL
  BIMESTRAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum InteractionChannel {
  WHATSAPP
  EMAIL
}

enum CompanyType {
  ART
  FLOTAS
  TRO
  CONSORCIO
  INTEGRAL_DE_COMERCIO
}

enum LifePolicyType {
  VIDA
  RETIRO
}

enum SiniestroEstado {
  DENUNCIADO
  EN_GESTION
  EN_INSPECCION
  EN_ANALISIS
  APROBADO
  RECHAZADO
  PAGADO
}

enum SiniestroProioridad {
  ALTA
  MEDIA
  BAJA
}

enum CotizacionTipo {
  AUTO
  MOTO
  HOGAR
  OTROS
}

enum CotizacionOrigen {
  MANUAL
  LINK_PUBLICO
}

enum CurrencyType {
  ARS
  USD
  EUR
  BRL
}

enum CommissionInvoiceStatus {
  PENDIENTE
  FACTURADA
  COBRADA
  PARCIAL
  VENCIDA
}

enum WhatsAppDeliveryStatus {
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WeeklySummaryStatus {
  PROCESSING
  ACCEPTED
  SENT
  DELIVERED
  READ
  FAILED
}

enum PolicyImportStatus {
  PROCESSING
  READY
  INCOMPLETE
  CONFIRMED
  FAILED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  password         String
  nombre           String
  telefono         String?
  direccion        String?
  avatar           String?
  matriculaPas     String?
  isAdmin          Boolean    @default(false)
  isTestUser       Boolean    @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  plan             PlanType   @default(TRIAL)
  planVencimiento  DateTime?
  trialInicio      DateTime   @default(now())
  trialFin         DateTime?
  estado           UserStatus @default(ACTIVO)
  referralCode     String     @unique
  referidosMes     Int        @default(0)
  referidosTotales Int        @default(0)
  lastLogin        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  clientes         Client[]
  empresas         Company[]
  polizas          Policy[]
  lifePolizas      LifePolicy[]
  commissionCloses CommissionClose[]
  referrals        Referral[]
  subscriptions    Subscription[]
  payments         Payment[]
  siniestros       Siniestro[]
  cotizaciones     Cotizacion[]
  insuranceCompanies InsuranceCompany[]
  brokers          Broker[]
  commissionInvoices CommissionInvoice[]
  policyCoupons      PolicyCoupon[]
  policyDocuments    PolicyDocument[]
  policyImportBatches PolicyImportBatch[]
  policyImportDocuments PolicyImportDocument[]
  policyImportCandidates PolicyImportCandidate[]
  couponDeliveries   WhatsAppCouponDelivery[]
  weeklySummaryDispatches WeeklySummaryDispatch[]
  messageTemplates   MessageTemplate[]
  suggestions        Suggestion[]
}

model Client {
  id        String   @id @default(uuid())
  userId    String
  nombre    String
  dni       String
  telefono  String
  email     String
  direccion String?
  altura    String?
  cp        String?
  provincia String?
  localidad String?
  fechaNacimiento DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  polizas Policy[]
  cotizaciones Cotizacion[]

  @@index([userId])
}

model Company {
  id          String      @id @default(uuid())
  userId      String
  razonSocial String
  cuit        String
  ramo        String?
  empleados   Int?
  vehiculos   Int?
  aseguradora String
  email       String
  telefono    String
  direccion   String?
  altura      String?
  cp          String?
  provincia   String?
  localidad   String?
  tipo        CompanyType
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  polizas Policy[]

  @@index([userId])
}

model Policy {
  id                       String              @id @default(uuid())
  userId                   String
  clienteId                String?
  companyId                String?
  clienteNombre            String
  clienteDni               String?
  clienteTelefono          String?
  clienteEmail             String?
  aseguradora              String
  rubro                    String
  numeroPoliza             String
  fechaInicio              DateTime
  fechaVencimiento         DateTime
  medioPago                String?
  tipoUso                  String?
  vigencia                 PolicyVigencia      @default(ANUAL)
  cuotaActual              Int                 @default(1)
  cuotaTotal               Int                 @default(1)
  groupId                  String?
  pagada                   Boolean             @default(false)
  fechaPago                DateTime?
  recordatorioProximoEnviadoAt DateTime?
  recordatorioVencidaEnviadoAt DateTime?
  renewalGeneratedAt DateTime?
  renewalGroupId            String?
  ultimaGestionTipo        InteractionChannel?
  ultimaGestionFecha       DateTime?
  ultimaGestionWhatsappCount Int               @default(0)
  ultimaGestionMailCount   Int                 @default(0)
  prima                    Float
  premioTotal              Float?
  cobertura                String?
  endoso                   String?
  patente                  String?
  chasis                   String?
  motor                    String?
  direccionRiesgo          String?
  moneda                   CurrencyType        @default(ARS)
  porcentajeComision       Float
  comisionCalculada        Float
  estado                   PolicyStatus        @default(ACTIVA)
  tipo                     PolicyType          @default(INDIVIDUAL)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliente Client?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  commissionInvoiceLinks CommissionInvoicePolicy[]

  @@index([userId])
  @@index([estado])
  @@index([fechaVencimiento])
  @@index([groupId])
}

model PolicyDocument {
  id            String   @id @default(uuid())
  userId        String
  policyGroupId String
  originalName  String
  storageKey    String   @unique
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyGroupId])
  @@index([userId])
  @@index([policyGroupId])
}

model PolicyImportBatch {
  id        String             @id @default(uuid())
  userId    String
  status    PolicyImportStatus @default(PROCESSING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents  PolicyImportDocument[]
  candidates PolicyImportCandidate[]

  @@index([userId])
  @@index([status])
}

model PolicyImportDocument {
  id           String             @id @default(uuid())
  batchId      String
  userId       String
  originalName String
  storageKey   String             @unique
  mimeType     String
  sizeBytes    Int
  status       PolicyImportStatus @default(PROCESSING)
  extractedText String?
  error        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  batch      PolicyImportBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidates PolicyImportCandidate[]

  @@index([batchId])
  @@index([userId])
  @@index([status])
}

model PolicyImportCandidate {
  id            String             @id @default(uuid())
  batchId       String
  documentId    String
  userId        String
  status        PolicyImportStatus @default(INCOMPLETE)
  data          Json
  foundFields   Json
  missingFields Json
  warnings      Json
  policyId      String?
  policyGroupId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  batch    PolicyImportBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  document PolicyImportDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([documentId])
  @@index([userId])
  @@index([status])
}

model PolicyCoupon {
  id            String   @id @default(uuid())
  userId        String
  policyGroupId String
  originalName  String
  storageKey    String   @unique
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WhatsAppCouponDelivery[]

  @@unique([userId, policyGroupId])
  @@index([userId])
  @@index([policyGroupId])
}

model WhatsAppCouponDelivery {
  id             String                    @id @default(uuid())
  couponId       String
  userId         String
  policyId       String
  recipient      String
  metaMessageId  String?                   @unique
  status         WhatsAppDeliveryStatus    @default(ACCEPTED)
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  coupon PolicyCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, createdAt])
  @@index([userId])
  @@index([policyId])
  @@index([status])
}

model WeeklySummaryDispatch {
  id             String              @id @default(uuid())
  userId         String
  weekStart      DateTime
  recipient      String
  policyCount    Int
  summaryText    String
  totalChunks    Int                 @default(1)
  status         WeeklySummaryStatus @default(PROCESSING)
  attemptCount   Int                 @default(1)
  lastAttemptAt  DateTime            @default(now())
  sentAt         DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages WeeklySummaryMessage[]

  @@unique([userId, weekStart])
  @@index([weekStart])
  @@index([status])
}

model WeeklySummaryMessage {
  id            String                 @id @default(uuid())
  dispatchId    String
  chunkIndex    Int
  metaMessageId String?                @unique
  status        WhatsAppDeliveryStatus @default(ACCEPTED)
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  dispatch WeeklySummaryDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@unique([dispatchId, chunkIndex])
  @@index([dispatchId])
  @@index([status])
}

model LifePolicy {
  id             String         @id @default(uuid())
  userId         String
  cliente        String
  cuit           String
  aseguradora    String
  tipo           LifePolicyType
  sumaAsegurada  Float?
  prima          Float?
  aporteMensual  Float?
  fondoAcumulado Float?
  tipoSeguro     String?
  edad           Int?
  edadRetiro     Int?
  incremento     Float?
  frecuenciaIncremento String?
  numeroPoliza   String?
  medioPago      String?
  fechaInicio    DateTime?
  fechaVencimiento DateTime?
  vigencia       PolicyVigencia?
  moneda         CurrencyType @default(ARS)
  altura         String?
  email          String?
  telefono       String?
  direccion      String?
  cp             String?
  localidad      String?
  provincia      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CommissionClose {
  id            String   @id @default(uuid())
  userId        String
  mes           Int
  anio          Int
  totalPrima    Float
  comisionBruta Float
  crecimiento   Float?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mes, anio])
  @@index([userId])
}

model Referral {
  id            String   @id @default(uuid())
  referrerId    String
  referredEmail String
  status        String   @default("pending")
  mes           Int
  anio          Int
  createdAt     DateTime @default(now())

  referrer User @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model Subscription {
  id                 String       @id @default(uuid())
  userId             String
  plan               PlanType
  billingCycle       BillingCycle @default(MONTHLY)
  precio             Float
  inicio             DateTime
  fin                DateTime
  estado             String       @default("activo")
  providerStatus     String?
  mpPaymentId        String?
  mpPreapprovalId    String?      @unique
  mpPreapprovalPlanId String?
  nextPaymentDate    DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mpPreapprovalPlanId])
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  monto          Float
  plan           String
  metodoPago     String?
  mpPaymentId    String?
  mpPreapprovalId String?
  estado         String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mpPaymentId])
  @@index([mpPreapprovalId])
}

model SubscriptionProviderPlan {
  id                String       @id @default(uuid())
  plan              PlanType
  billingCycle      BillingCycle
  price             Float
  reason            String
  status            String
  mpPreapprovalPlanId String     @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([plan, billingCycle])
  @@index([status])
}

model PlanConfiguration {
  id                   String   @id @default(uuid())
  plan                 PlanType @unique
  name                 String
  monthlyPrice         Float
  isVisible            Boolean  @default(true)
  annualEnabled        Boolean  @default(true)
  annualDiscountMonths Int      @default(2)
  features             Json
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Siniestro {
  id                         String              @id @default(uuid())
  userId                     String
  numeroSiniestro            String
  numeroPoliza               String
  aseguradora                String
  tipoSeguro                 String
  clienteNombre              String
  clienteDni                 String?
  clienteTelefono            String?
  clienteEmail               String?
  fechaSiniestro             DateTime
  horaSiniestro              String?
  lugarSiniestro             String?
  descripcion                String
  patente                    String?
  marcaModelo                String?
  tipoDanio                  String?
  terceroNombre              String?
  terceroMarcaModeloVehiculo String?
  terceroDanios              String?
  terceroCelular             String?
  terceroDireccion           String?
  terceroDni                 String?
  terceroAseguradora         String?
  estado                     SiniestroEstado     @default(DENUNCIADO)
  prioridad                  SiniestroProioridad @default(BAJA)
  responsable                String?
  importeReclamado           Float?
  deducible                  Float?
  montoAprobado              Float?
  ultimoContactoAseguradora  DateTime?
  ultimoContactoCliente      DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notas SiniestroNota[]

  @@index([userId])
  @@index([estado])
}

model SiniestroNota {
  id          String    @id @default(uuid())
  siniestroId String
  texto       String
  createdAt   DateTime  @default(now())

  siniestro Siniestro @relation(fields: [siniestroId], references: [id], onDelete: Cascade)

  @@index([siniestroId])
}

model Cotizacion {
  id                 String           @id @default(uuid())
  userId             String
  clientId           String?
  tipo               CotizacionTipo
  origen             CotizacionOrigen @default(MANUAL)
  nombre             String
  apellido           String?
  cuitCuil           String?
  fechaNacimiento    String?
  email              String?
  celular            String?
  calle              String?
  cp                 String?
  localidad          String?
  provincia          String?
  marca              String?
  modelo             String?
  anio               Int?
  patente            String?
  tipoUso            String?
  tieneGnc           Boolean?
  tieneGps           Boolean?
  formaPago          String?
  tipoVivienda       String?
  superficieCubierta Float?
  descripcionRiesgo  String?
  viewedAt           DateTime?
  managedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tipo])
  @@index([viewedAt])
  @@index([clientId])
}

model InsuranceCompany {
  id                      String   @id @default(uuid())
  userId                  String
  razonSocial             String
  cuit                    String
  domicilioComercial      String?
  ivaCondition            String?
  email                   String?
  telefono                String?
  websiteUrl              String?
  portalLoginUrl          String?
  portalUsername          String?
  portalPasswordEncrypted String?
  producerCode            String?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerLinks BrokerInsuranceCompany[]
  commissionInvoices CommissionInvoice[]

  @@index([userId])
  @@index([cuit])
}

model Broker {
  id             String   @id @default(uuid())
  userId         String
  nombre         String
  color          String
  contactoNombre String?
  email          String?
  telefono       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  insurerLinks BrokerInsuranceCompany[]

  @@index([userId])
}

model BrokerInsuranceCompany {
  brokerId           String
  insuranceCompanyId String
  createdAt          DateTime @default(now())

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)

  @@id([brokerId, insuranceCompanyId])
  @@index([insuranceCompanyId])
}

model CommissionInvoice {
  id                 String                  @id @default(uuid())
  userId             String
  insuranceCompanyId String?
  periodo            String
  numeroFactura      String
  numeroLiquidacion  String?
  fechaEmision       DateTime
  fechaVencimiento   DateTime?
  estado             CommissionInvoiceStatus @default(PENDIENTE)
  monto              Float
  moneda             CurrencyType            @default(ARS)
  comprobanteUrl     String?
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  insuranceCompany InsuranceCompany? @relation(fields: [insuranceCompanyId], references: [id], onDelete: SetNull)
  payments CommissionInvoicePayment[]
  policies CommissionInvoicePolicy[]

  @@index([userId])
  @@index([insuranceCompanyId])
  @@index([periodo])
  @@index([estado])
}

model MessageTemplate {
  id        String   @id @default(uuid())
  userId    String
  nombre    String
  categoria String   @default("GENERAL")
  contenido String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoria])
}

model Suggestion {
  id         String   @id @default(uuid())
  userId     String
  asunto     String
  mensaje    String
  estado     String   @default("PENDIENTE")
  respuesta  String?
  respondedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([estado])
}

model CommissionInvoicePayment {
  id             String   @id @default(uuid())
  invoiceId      String
  fechaPago      DateTime
  monto          Float
  medioPago      String?
  comprobanteUrl String?
  createdAt      DateTime @default(now())

  invoice CommissionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model CommissionInvoicePolicy {
  invoiceId String
  policyId  String
  createdAt DateTime @default(now())

  invoice CommissionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@id([invoiceId, policyId])
  @@index([policyId])
}

model LandingContactLead {
  id        String   @id @default(uuid())
  nombre    String
  email     String
  telefono  String?
  asunto    String
  mensaje   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@ignore
}

model LandingProducerLead {
  id             String   @id @default(uuid())
  nombre         String
  email          String
  telefono       String
  provincia      String?
  experiencia    String?
  mensaje        String?
  cvOriginalName String?
  cvMimeType     String?
  cvSizeBytes    Int?
  cvContent      Bytes?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@ignore
}
